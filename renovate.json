{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "kubernetes": {
    "managerFilePatterns": ["/^platform\\/components\\/[^/]+\\/(?:pre-resources|resources)\\/.*\\.ya?ml$/"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update index-backed Helm charts in the platform configuration",
      "managerFilePatterns": ["/^platform\\/values\\/values-prod\\.yaml$/"],
      "datasourceTemplate": "helm",
      "matchStrings": [
        "repoURL:[ \\t]+(?<registryUrl>https?://[^\\s]+)\\s+name:[ \\t]+(?<depName>[^\\s]+)\\s+version:[ \\t]+\"?(?<currentValue>[^\\s\"]+)"
      ]
    },
    {
      "customType": "regex",
      "description": "Update OCI Helm charts in the platform configuration",
      "managerFilePatterns": ["/^platform\\/values\\/values-prod\\.yaml$/"],
      "datasourceTemplate": "docker",
      "depNameTemplate": "{{{repository}}}/{{{chart}}}",
      "matchStrings": [
        "repoURL:[ \\t]+(?<repository>(?:ghcr\\.io|docker\\.io)/[^\\s]+)\\s+name:[ \\t]+(?<chart>[^\\s]+)\\s+version:[ \\t]+\"?(?<currentValue>[^\\s\"]+)"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Group LinuxServer media stack updates",
      "matchPackageNames": ["/^lscr\\.io\\/linuxserver\\//"],
      "groupName": "linuxserver media stack",
      "automerge": false
    },
    {
      "description": "Group monitoring stack updates",
      "matchPackageNames": ["/^(prom|grafana)\\//"],
      "groupName": "monitoring stack",
      "automerge": false
    },
    {
      "description": "Group platform Helm chart updates",
      "matchDatasources": ["helm"],
      "groupName": "platform helm charts",
      "automerge": false
    }
  ],
  "prHourlyLimit": 3,
  "prConcurrentLimit": 10,
  "automerge": false,
  "labels": ["dependencies", "renovate"],
  "commitMessagePrefix": "chore(deps):",
  "reviewers": [],
  "assignees": []
}
