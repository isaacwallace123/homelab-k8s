# EXAMPLE topology for the homelab k3s cluster. Copy to terraform.tfvars and fill in the
# three REPLACE-ME values plus your SSH keys.
#
# GENERATED FROM the live terraform.tfvars with secrets redacted, deliberately: the previous
# example had drifted into a topology that the validations in variables.tf now reject
# (pools "storage"/"infra"/"platform" no longer exist, and its etcd majority sat on the
# wrong host). An example that cannot pass `terraform plan` is worse than no example.
#
# Regenerate after any topology change so the two cannot diverge again.

proxmox_endpoint  = "https://192.168.0.254:8006"
proxmox_api_token = "root@pam!terraform=REPLACE-ME"
# Every key that needs to administer a node belongs here — a list, not a single key,
# because the first two nodes were built with a key whose private half did not exist on
# the machine that runs Ansible, which made them unreachable.
ssh_public_keys = [
  "ssh-ed25519 AAAA... you@example.com",
]
vm_password = "REPLACE-ME"
k3s_token   = "REPLACE-ME  # openssl rand -base64 64"

# pve2 holds NO templates, so it cross-node clones the one on cyberlab.
templates = {
  pve2     = { vmid = 9000, node = "cyberlab" }
  cyberlab = { vmid = 9000, node = "cyberlab" }
}

# =============================================================================
# TWO PLANES.
#
#   pve2      storage plane — TrueNAS, media, the cloud tier, one etcd member
#   cyberlab  compute plane — general apps, the etcd majority
#
# The split follows the hardware. pve2 is an R5 5500: 12 threads, 62.7 GiB, and it also
# serves every NFS export in the cluster, so its I/O is the contended resource. cyberlab
# has 24 threads and 128 GiB. Putting general compute and the etcd majority on cyberlab
# leaves pve2 doing what only pve2 can do — sit next to the disks and the Arc A380.
#
# MEMORY BUDGET (do not exceed without re-checking `free -g` on the host):
#   pve2      TrueNAS 8 + cp-01 4 + media-01 16 + cloud-01 18  = 46 of 62.7 GiB
#   cyberlab  cp-02 4 + cp-03 4 + work-01 12 + work-02 12      = 32 GiB,
#             on top of ~71 GiB already held by the cyber range and the AI VMs = 103 of 128
#
# APPLYING THIS IS NOT A SINGLE `terraform apply`. Three of the changes below are moves or
# renames that Terraform would otherwise plan as destroy-and-recreate, and one of them
# carries a GPU and Longhorn replicas. Follow docs/architecture/topology-migration.md.
# =============================================================================
nodes = {

  # ── pve2 — storage plane ───────────────────────────────────────────────────
  "k8s-cp-01" = {
    host      = "pve2"
    vmid      = 104
    ip        = "192.168.0.10"
    role      = "server"
    pool      = "control"
    cores     = 2
    # 6 GiB -> 4. It is an etcd member, not a workload host; the other two run fine on 4
    # and the 2 GiB is worth more as headroom on the host that carries media and cloud.
    memory    = 4096
    disk_size = 80
    # machine intentionally unset: this VM predates the setting and Proxmox reports the
    # implicit i440fx, which is not a value the provider accepts. Setting q35 would rewrite
    # the machine type of a running control plane.
    description = "k3s control plane — etcd voting member (minority host)"
    tags        = ["control-plane"]
  }

  # ── cyberlab — compute plane ───────────────────────────────────────────────
  # MOVED from pve2 (was vmid 105). This is the change that fixes quorum: with cp-02 and
  # cp-03 both here, cyberlab holds 2 of 3 etcd members and the cluster survives losing
  # pve2. It does NOT survive losing cyberlab — that is the deliberate trade recorded in
  # var.quorum_host, and it is enforced by a validation in variables.tf.
  #
  # Changing `host` and `vmid` together is a replacement, which prevent_destroy blocks.
  # The migration doc removes the old VM and `terraform state rm`s it first, so Terraform
  # sees a clean create rather than a move.
  "k8s-cp-02" = {
    machine     = "q35"
    host        = "cyberlab"
    vmid        = 802
    ip          = "192.168.0.11"
    role        = "server"
    pool        = "control"
    cores       = 2
    memory      = 4096
    disk_size   = 60
    description = "k3s control plane — etcd voting member (majority host)"
    tags        = ["control-plane"]
  }

  # Holds the Intel Arc A380 (mapped via hostpci0).
  #
  # RENAMED from k8s-store-01 — "store" was never accurate; TrueNAS is the storage, this
  # is the transcode and library node. The map key is the Proxmox VM name, so this rename
  # is a `terraform state mv`, NOT an apply. Getting that wrong destroys the node: a bios
  # change already did exactly that once (commit 2dce49d), and it took the Longhorn
  # replicas with it.
  #
  # The KUBERNETES node name stays `k8s-store-01` until the node is drained and rejoined,
  # because that name comes from the OS hostname set at k3s install time. Nothing depends
  # on it — placement is entirely by pool label — and node-topology.yml maps the two.
  "k8s-media-01" = {
    host          = "pve2"
    vmid          = 107
    ip            = "192.168.0.12"
    role          = "agent"
    pool          = "media"
    machine       = "q35"
    bios          = "ovmf"
    efi_datastore = "local-lvm"
    # 8 -> 6 cores and 24 -> 16 GiB. Plex transcodes on the Arc, not the CPU, and the
    # measured working set never approached 24. The freed 8 GiB is what makes room for the
    # cloud node below on a host that had 11 GiB left.
    cores         = 6
    memory        = 16384
    disk_size     = 150
    hostpci = [
      {
        device  = "hostpci0"
        mapping = "homelab-intel-arc-a380"
        pcie    = true
        rombar  = true
      }
    ]
    description = "k3s worker — media, Plex (Arc A380), Longhorn replicas"
    tags        = ["worker", "media", "gpu"]
    labels      = { "node-role.kubernetes.io/worker" = "true", "homelab.isaacwallace.dev/gpu" = "intel-arc" }
    # Taint key matches the pool label. Only workloads that ask for the media pool land
    # here, so nothing competes with Plex for the Arc or with the NFS path for I/O.
    taints = ["homelab.isaacwallace.dev/pool=media:NoSchedule"]
  }

  # The cloud tier. Nextcloud, Immich, Garage (S3), Vaultwarden, Stirling-PDF and the
  # CloudNativePG clusters behind them.
  #
  # On pve2 because all of it is storage-bound: Nextcloud's files and Immich's originals
  # live on the TrueNAS exports, and Garage's buckets sit on the same pool. Running them
  # on cyberlab would push every read and write across the LAN.
  #
  # NOT on the media node, even though both are storage-bound: the Arc A380 passes through
  # to exactly one VM, Plex has it, and Immich's ML would otherwise contend for it. Immich
  # runs its ML on CPU here. If photo transcoding ever matters more than Plex transcoding,
  # that is a one-line pool change in the Immich manifest, not a rebuild.
  "k8s-cloud-01" = {
    host      = "pve2"
    vmid      = 108
    # VERIFY THIS IS FREE before applying — .13 was k8s-infra-01 and is deliberately not
    # reused, so that a stale ARP entry or known_hosts line cannot point at the new node.
    ip        = "192.168.0.15"
    role      = "agent"
    pool      = "cloud"
    machine   = "q35"
    cores     = 4
    memory    = 18432
    disk_size = 150
    description = "k3s worker — Nextcloud, Immich, Garage, Vaultwarden, Stirling-PDF"
    tags        = ["worker", "cloud"]
    labels      = { "node-role.kubernetes.io/worker" = "true" }
    # Same pattern as the media node: a dedicated pool that general workloads cannot drift
    # onto, so the cloud tier's I/O stays predictable next to TrueNAS.
    taints = ["homelab.isaacwallace.dev/pool=cloud:NoSchedule"]
  }

  # ── RETIRED: k8s-infra-01 (pve2, vmid 110, 192.168.0.13) ───────────────────
  # Deleted rather than rebuilt.
  #
  # It was a single point of failure with a dedicated node's cost: Prometheus, Loki,
  # Grafana, Alertmanager, cloudflared and ntfy all selected node-role.kubernetes.io/infra,
  # a label only this machine carried, so losing it took out all observability and all
  # ingress at once. Those workloads now select `pool: apps` and spread across the two
  # cyberlab workers, which is both more available and 8 GiB cheaper on pve2.
  #
  # It also held the legacy Kubernetes name `k3s-worker-infra`, so retiring it removes
  # half the naming drift by deletion instead of by a risky rebuild.
  #
  # Its Longhorn replicas MUST be evicted before the VM is removed. See the migration doc.

  # ── cyberlab (LAN bridge only, never a range bridge) ───────────────────────
  "k8s-cp-03" = {
    machine         = "q35"
    host            = "cyberlab"
    vmid            = 801
    ip              = "192.168.0.14"
    role            = "server"
    pool            = "control"
    cores           = 2
    memory          = 4096
    memory_floating = 2048
    disk_size       = 60
    description     = "k3s control plane — etcd voting member (minority host)"
    tags            = ["control-plane"]
  }

  # ── cyberlab workers ───────────────────────────────────────────────────────
  # General workloads live here, not on pve2. cyberlab had 53 GiB free while pve2 was
  # down to 11 GiB with four of the five k8s VMs on it. Sized at 12 GiB each rather than
  # 16 so the host keeps ~10 GiB of headroom above its 92 GiB of existing allocation.
  #
  # These are also what finally makes longhorn-replicated meaningful: with workers on both
  # Proxmox hosts, zone anti-affinity places replicas across physical machines instead of
  # across VMs on the same box.
  "k8s-work-01" = {
    host            = "cyberlab"
    vmid            = 810
    ip              = "192.168.0.16"
    role            = "agent"
    pool            = "apps"
    machine         = "q35"
    cores           = 6
    memory          = 12288
    memory_floating = 4096
    disk_size       = 120
    description     = "k3s worker — general apps, Crossplane, arena"
    tags            = ["worker", "apps"]
    labels          = { "node-role.kubernetes.io/worker" = "true" }
  }

  # 24 GiB with ballooning OFF (floating == memory), and 250G of disk. Both are for the
  # Minecraft server pinned here — 244 mods on a 12G pre-touched heap, and a world
  # pre-generated across a dozen dimensions on strict-local Longhorn storage.
  #
  # Ballooning and Kubernetes do not mix: the kubelet computes allocatable from the memory
  # resident when it reads /proc/meminfo, not from the VM's configured maximum. work-01,
  # deflated, advertises ~3.9 GiB of its configured 12 and could not run that pod at all.
  #
  # NOTE: `disk_size` is honoured at CREATE only — nodes.tf has `disk` in ignore_changes so
  # Terraform can never detach k8s-store-01's passed-through media drive. Growing a disk on
  # an existing node is manual: `qm resize <vmid> scsi0 <size>` on the Proxmox host, then
  # growpart + resize2fs inside the guest. Memory, by contrast, does apply from here.
  "k8s-work-02" = {
    host            = "cyberlab"
    vmid            = 811
    ip              = "192.168.0.17"
    role            = "agent"
    pool            = "apps"
    machine         = "q35"
    cores           = 6
    memory          = 24576
    memory_floating = 24576
    disk_size       = 250
    description     = "k3s worker — general apps, game servers, second Longhorn replica target"
    tags            = ["worker", "apps"]
    labels          = { "node-role.kubernetes.io/worker" = "true" }
  }
}
